# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# CYPHER65 · WAR ROOM · Environment Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control. It's in .gitignore.

# ── Wallet & Mining ──────────────────────────────────────────────────
BTC_ADDRESS=bc1qpc3832jcu6m8qpqjvz5lkuydwjzv8v5vq5t5rs
WORKER_NAME=cypher65

# ── API Endpoints ────────────────────────────────────────────────────
# Set these if you need to override the default public API URLs.
# PARASITE_API=https://parasite.space/api
# MEMPOOL_API=https://mempool.space/api

# ── Market Intelligence (optional) ───────────────────────────────────
# MRR_API_KEY=
# MRR_API_SECRET=

# ── Security ─────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random key is generated on each restart (invalidates sessions).
SECRET_KEY=

# Static API key for optional basic HTTP authentication
# API_KEY=

# Multi-tenant API keys (Fase 4 · B1): JSON dict tenant_id -> api_key.
# When set, /api/auth/login issues JWTs with sub=tenant_id, activating the
# axe_fleet tenant isolation. Falls back to the single API_KEY (tenant "default").
# Example: TENANT_API_KEYS={"acme":"key-acme-1","brave":"key-brave-2"}

# ── Push Notifications (VAPID) ───────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# ── Server ───────────────────────────────────────────────────────────
PORT=8765
POLL_INTERVAL=15
RATE_LIMIT_PER_MINUTE=60

# ── Optional ─────────────────────────────────────────────────────────
# DEBUG=0
# WEBHOOK_URL=https://discord.com/api/webhooks/...
