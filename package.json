{
  "name": "cypher65-war-room-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "E2E tests for CYPHER65 War Room dashboard",
  "scripts": {
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:debug": "npx playwright test --debug",
    "test:e2e:report": "npx playwright show-report e2e-report",
    "gen:qr-golden": "node scripts/gen_qr_golden.cjs",
    "audit:ui": "node scripts/audit_ui.cjs",
    "audit:ui:all": "node scripts/audit_ui.cjs --all",
    "check:frontend": "bash scripts/check_frontend.sh",
    "check:dom": "node scripts/check-dom-regression.cjs",
    "test:dom-guards": "node tests/test_dom_guards.js",
    "lint:commit": "commitlint --from HEAD~1"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "qrcode-terminal": "^0.12.0",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2"
  }
}
