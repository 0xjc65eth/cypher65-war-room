venv/
__pycache__/
*.pyc
*.sqlite
*.sqlite-shm
*.sqlite-wal
.DS_Store
*.log
.env

# Backup files
*.backup*
*.backup.*
backup*

node_modules/
test-results/
e2e-report/

# Runtime artifacts
.coverage

# Rascunhos locais de corpo de issue/PR (evitam escaping de heredoc em textos
# longos). Nunca devem ser commitados: o PR #530 versionou um `.tmp-pr-*-body.md`
# por acidente, porque o arquivo foi criado em paralelo a um `git add -A`.
.tmp-*
# Mutation testing (mutmut) artifacts — local-only
.mutmut-cache
*.py.bak
mobile/reports/
data/*.db
# Production SQLite backups / corrupt snapshots must never reach the repo
data/*.bak*
data/*.corrupt*

# Backups antigos de assets — o Flask serve qualquer arquivo em static/,
# então um .bak com código desatualizado (ex. handler quebrado do Restart)
# não deve ficar exposto publicamente em /static/*.bak.
static/*.bak*
static/*.bak2
data/*-wal
data/*-shm
.aider*

# Skill tooling artifacts (npx skills) — local-only, not part of the app
.claude/
.agents/*
skills-lock.json

# Skills do projeto são VERSIONADOS (decisão CTO, Issue #121) — viajam com o
# repo para que qualquer agente de qualquer modelo os carregue em qualquer clone.
# Mantém-se ignorado apenas o tooling local (.claude/, skills-lock.json acima).
!.agents/skills/
!.agents/skills/**
# .DS_Store volta a ser lixo mesmo dentro do dir versionado de skills
# (a negação acima re-inclui tudo; last-match-wins re-ignora só o lixo)
.agents/skills/**/.DS_Store

# Papéis da equipe multi-agente também são VERSIONADOS (Issue #596) — mesmo
# racional das skills: viajam com o repo para que qualquer agente de qualquer
# modelo assuma o papel em qualquer clone. Sem esta exceção os 30 arquivos de
# `.agents/agents/` seriam silenciosamente ignorados pela regra `.agents/*`.
!.agents/agents/
!.agents/agents/**
.agents/agents/**/.DS_Store
