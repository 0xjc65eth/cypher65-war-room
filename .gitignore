venv/
__pycache__/
*.pyc
*.sqlite
*.sqlite-shm
*.sqlite-wal
.DS_Store
*.log
.env
.agents/*

# Backup files
*.backup*
*.backup.*
backup*

node_modules/
test-results/
e2e-report/

# Runtime artifacts
.coverage
# Mutation testing (mutmut) artifacts — local-only
.mutmut-cache
*.py.bak
data/*.db
# Production SQLite backups / corrupt snapshots must never reach the repo
data/*.bak*
data/*.corrupt*

# Backups antigos de assets — o Flask serve qualquer arquivo em static/,
# então um .bak com código desatualizado (ex. handler quebrado do Restart)
# não deve ficar exposto publicamente em /static/*.bak.
static/*.bak*
static/*.bak2
data/*-wal
data/*-shm
.aider*

# Skill tooling artifacts (npx skills) — local-only, not part of the app
.claude/
.agents/*
skills-lock.json

# Skills do projeto são VERSIONADOS (decisão CTO, Issue #121) — viajam com o
# repo para que qualquer agente de qualquer modelo os carregue em qualquer clone.
# Mantém-se ignorado apenas o tooling local (.claude/, skills-lock.json acima).
!.agents/skills/
!.agents/skills/**
