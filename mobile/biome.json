{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": false },
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/coverage",
			"!**/ios",
			"!**/android",
			"!**/.expo"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"indentWidth": 2,
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": { "noUnusedVariables": "warn" },
			"suspicious": { "noArrayIndexKey": "warn", "noExplicitAny": "warn" }
		}
	},
	"javascript": {
		"formatter": { "quoteStyle": "single", "semicolons": "always" }
	}
}
