{
  "name": "cypher65-mobile",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "run:ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "test:security-braces": "node scripts/check-braces-fix.cjs && node --test scripts/check-braces-fix.test.cjs",
    "test:security-node-forge": "node scripts/check-node-forge-fix.cjs",
    "lint": "biome lint --error-on-warnings src App.tsx",
    "lint:biome": "biome lint --error-on-warnings src App.tsx",
    "lint:knip": "knip",
    "mutate": "stryker run",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "build:ios": "expo export --platform ios --output-dir dist/ios",
    "native:generate:ios": "expo prebuild --platform ios --clean --no-install",
    "config:ios": "expo config --type public --json",
    "build:android": "expo export --platform android --output-dir dist/android",
    "build:web": "expo export --platform web --output-dir dist/web",
    "build": "npm run build:ios && npm run build:android && npm run build:web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@tanstack/react-query": "^5.104.0",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.3",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "^2.5.14",
    "@react-native/jest-preset": "^0.86.3",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/jest-runner": "10.0.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "braces": "file:vendor/braces-3.0.4-cypher65.1.tgz",
    "expo-doctor": "^1.20.4",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "knip": "^6.38.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "decode-uri-component": "0.5.0",
    "brace-expansion@^1.1.7": "^1.1.21",
    "brace-expansion@^5.0.8": "^5.0.12",
    "node-forge": "git+https://github.com/digitalbazaar/forge.git#ceba34402e329f0365134f23fe19898756527d65",
    "braces": "$braces",
    "qs": "6.16.0",
    "uuid": "11.1.1"
  }
}
