{
  "name": "cypher65-mobile",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "run:ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "biome lint --error-on-warnings src App.tsx",
    "lint:biome": "biome lint --error-on-warnings src App.tsx",
    "lint:knip": "knip",
    "mutate": "stryker run",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "build:ios": "expo export --platform ios --output-dir dist/ios",
    "native:generate:ios": "expo prebuild --platform ios --clean --no-install",
    "config:ios": "expo config --type public --json",
    "build:android": "expo export --platform android --output-dir dist/android",
    "build:web": "expo export --platform web --output-dir dist/web",
    "build": "npm run build:ios && npm run build:android && npm run build:web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "@tanstack/react-query": "^5.36.0",
    "axios": "^1.6.8",
    "date-fns": "^3.6.0",
    "expo": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-local-authentication": "~57.0.2",
    "expo-notifications": "~57.0.15",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@biomejs/biome": "^2.0.0",
    "@react-native/jest-preset": "^0.86.3",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "expo-doctor": "^1.20.4",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "knip": "^5.44.0",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
