{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "CYPHER65_APP_ENV": "development"
      }
    },
    "testing": {
      "distribution": "internal",
      "env": {
        "CYPHER65_APP_ENV": "testing"
      }
    },
    "staging": {
      "distribution": "internal",
      "env": {
        "CYPHER65_APP_ENV": "staging"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "CYPHER65_APP_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
